# --- Railway Postgres ---
# Railway dashboard -> Postgres -> Connect -> Postgres Connection URL
DATABASE_URL="postgresql://user:pass@host:5432/railway"

# --- cornish-core (shared back-office: ledger + CRM) ---
# Paid orders and expenses are pushed here. Leave URL/secret blank to disable
# (calls no-op). CORNISH_BRAND is this site's brand key in cornish-core.
CORNISH_CORE_URL=""
CORNISH_BRAND="STICKS"
INGEST_SECRET_STICKS=""

# --- Clover Hosted Checkout ---
# Sandbox: https://sandbox.dev.clover.com  |  Production: https://www.clover.com
# Merchant ID: Clover dashboard -> Setup -> Merchants
CLOVER_MERCHANT_ID=""
# API token with "Online payments / Checkout" permission (Setup -> API Tokens)
CLOVER_API_TOKEN=""
# apisandbox.dev.clover.com for testing, api.clover.com for production
CLOVER_API_BASE="https://apisandbox.dev.clover.com"
# Signing Secret from Clover dashboard -> Settings -> Ecommerce -> Hosted
# Checkout -> Webhook section. REQUIRED in production — without it the
# webhook rejects all payment-confirmation events (see app/api/webhooks/clover).
CLOVER_WEBHOOK_SECRET=""

# --- Clerk (optional — site works without it; guest checkout always allowed) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Admin dashboard (/admin) ---
# Shared password for the single-owner admin gate. Use a long random value.
ADMIN_PASSWORD=""
# Optional: separate secret used to sign admin session tokens. Falls back to
# a hash of ADMIN_PASSWORD if unset — set this explicitly to rotate sessions
# independently of the login password.
ADMIN_SESSION_SECRET=""

# --- Email (Resend) ---
# Transactional mail: order confirmations, ready-for-pickup notices, low-stock
# alerts, contact-form + broadcast. All no-op silently until RESEND_API_KEY is
# set, so the app runs fine without it.
RESEND_API_KEY=""
# Recipient for SHOP-facing alerts (low stock, contact form, warranty). Your
# inbox, not the customer's.
ALERT_EMAIL=""
# Visible sender. Must be on a domain VERIFIED in Resend (Dashboard → Domains →
# add stlhockeysticks.com, then add the DKIM/SPF records to DNS). Until the
# domain is verified, leave this as the resend.dev sandbox — but note that
# sandbox sender can only email your own verified address, NOT real customers.
#   verified:  "STL Hockey Sticks <orders@stlhockeysticks.com>"
#   sandbox:   "STL Hockey Sticks <onboarding@resend.dev>"
EMAIL_FROM="STL Hockey Sticks <onboarding@resend.dev>"
# Where customer replies land. orders@ is send-only via Resend, so replies need
# a real inbox that's actually read. Point at a domain mailbox once you have
# one; a personal address is fine to start. Leave blank to send with no
# reply-to (replies then bounce back to EMAIL_FROM, which nobody reads).
REPLY_TO_EMAIL=""
# Secret gating the nightly-summary cron (/api/cron/daily-summary). Vercel Cron
# sends this automatically as `Authorization: Bearer $CRON_SECRET`. In
# production the endpoint refuses to run without it. Any long random string:
#   openssl rand -hex 32
CRON_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://stlhockeysticks.com"
# Pickup location shown at checkout + footer
NEXT_PUBLIC_PICKUP_ADDRESS="St. Louis, MO (exact address emailed with pickup confirmation)"
